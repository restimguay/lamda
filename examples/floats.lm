// Floats: 64-bit IEEE, printed like Rust's `{:?}`.

fn hypot(a: float, b: float) -> float { sqrt(a * a + b * b) }

fn mean(xs: arr) -> float {
    be mut total = 0;
    be mut i = 0;
    while i < len(xs) { total = total + xs[i]; i = i + 1; }
    float(total) / float(len(xs))
}

fn main() {
    print(hypot(3.0, 4.0));            // 5.0
    print(0.1 + 0.2);                  // 0.30000000000000004
    print(1.0 / 3.0);                  // 0.3333333333333333
    print(6.02e23);                    // 6.02e23
    print(-7.5 % 2.0);                 // -1.5
    print(1.0 / 0.0);                  // inf

    be xs = array(4);
    xs[0] = 1; xs[1] = 2; xs[2] = 3; xs[3] = 5;
    print(mean(xs));                   // 2.75

    print(int(2.99) + int(-2.99));     // 0: truncates toward zero
    print(floor(-2.5) + ceil(2.1));    // 0.0
    print(max(1.5, pow(2.0, 0.5)));    // 1.5
    print(str(1e-7) + " and " + str(float("2.5e3")));   // 1e-7 and 2500.0
}
